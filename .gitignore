node_modules/
dist/
# build/content-manifest.json — where a content build records what each _id came from.
# Provenance is kept out of the shipped packs, and regenerating it is one command.
build/
.DS_Store
*.zip
*.log

# The compiled LevelDB compendiums are a build output: scripts/packs.sh builds
# them from packs/_source/, and the release workflow does the same before
# zipping. Only the JSON sources are tracked.
packs/*/
!packs/_source/

# Playwright e2e harness (all generated locally)
test/foundry-data/
test-results/
playwright-report/
playwright/.cache/

# Agent worktrees (git metadata lives in .git/worktrees; never a repo file)
.claude/worktrees/
