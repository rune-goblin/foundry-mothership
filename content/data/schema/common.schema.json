{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/common.schema.json",
  "title": "Shared value types",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "required": ["book", "system", "version", "page"],
      "properties": {
        "book": { "type": "string" },
        "system": { "type": "string" },
        "version": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "section": { "type": "string", "pattern": "^\\d{1,2}\\.\\d{1,2}$" }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": ["object", "null"],
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string" },
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "each": { "type": "boolean" },
        "formula": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dice": { "type": ["string", "null"], "pattern": "^\\d+d\\d+([+-]\\d+)?$" },
    "damage": {
      "type": ["object", "null"],
      "required": ["raw", "antiArmor"],
      "properties": {
        "raw": { "type": "string" },
        "formula": { "$ref": "#/$defs/dice" },
        "antiArmor": { "type": "boolean" },
        "expression": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rangeBand": {
      "type": ["string", "null"],
      "enum": ["adjacent", "close", "long", "extreme", null]
    },
    "modifiers": {
      "type": "array",
      "items": { "enum": ["advantage", "disadvantage"] },
      "uniqueItems": true
    },
    "rollRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "duration": {
      "type": ["object", "null"],
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string" },
        "minutes": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "woundType": {
      "enum": ["blunt-force", "bleeding", "gunshot", "fire-explosives", "gore-massive"]
    },
    "rolledValue": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": { "type": "string" },
        "formula": { "$ref": "#/$defs/dice" },
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      },
      "additionalProperties": false
    },
    "rollTable": {
      "type": "object",
      "required": ["id", "name", "die", "results"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "die": { "type": "string", "pattern": "^\\d+d\\d+$" },
        "rule": { "type": "string" },
        "class": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/source" },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["range"],
            "properties": {
              "range": { "$ref": "#/$defs/rollRange" },
              "text": { "type": "string" },
              "name": { "type": "string" },
              "effect": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } },
              "grantsCondition": { "type": "boolean" },
              "modifiers": { "$ref": "#/$defs/modifiers" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
