{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/equipment.schema.json",
  "title": "Equipment",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "cost",
      "source"
    ],
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "cost": {
        "$ref": "common.schema.json#/$defs/cost"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "source": {
        "$ref": "common.schema.json#/$defs/source"
      },
      "packSize": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  }
}
