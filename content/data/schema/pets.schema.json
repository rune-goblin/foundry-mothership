{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/pets.schema.json",
  "title": "Pets",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "wounds", "health", "instinct", "traits", "source"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "wounds": { "type": "integer", "minimum": 1 },
      "health": { "type": "integer", "minimum": 1 },
      "instinct": { "type": "string", "pattern": "^\\d+d\\d+([+-]\\d+)?$" },
      "traits": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "source": { "$ref": "common.schema.json#/$defs/source" }
    },
    "additionalProperties": false
  }
}
