{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/shore-leave.schema.json",
  "title": "Shore leave",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "portClass", "cost", "stressConverted", "source"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "portClass": { "type": "string", "pattern": "^[A-Z]$" },
      "cost": { "$ref": "common.schema.json#/$defs/cost" },
      "stressConverted": { "$ref": "common.schema.json#/$defs/rolledValue" },
      "source": { "$ref": "common.schema.json#/$defs/source" }
    },
    "additionalProperties": false
  }
}
