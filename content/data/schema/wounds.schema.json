{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/wounds.schema.json",
  "title": "Wounds",
  "type": "object",
  "required": ["id", "die", "severityByRoll", "tables", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "die": { "const": "1d10" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "severityByRoll": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "name"],
        "properties": {
          "from": { "type": "integer", "minimum": 0, "maximum": 9 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "results"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/woundType" },
          "name": { "type": "string", "minLength": 1 },
          "results": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "required": ["range", "effect", "modifiers"],
              "properties": {
                "range": { "$ref": "common.schema.json#/$defs/rollRange" },
                "effect": { "type": "string", "minLength": 1 },
                "modifiers": { "$ref": "common.schema.json#/$defs/modifiers" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
