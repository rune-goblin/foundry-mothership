{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/cover.schema.json",
  "title": "Cover",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "examples", "armorPoints", "damageReduction", "source"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "examples": { "type": "string", "minLength": 1 },
      "armorPoints": { "type": "integer", "minimum": 0 },
      "damageReduction": { "type": "integer", "minimum": 0 },
      "source": { "$ref": "common.schema.json#/$defs/source" }
    },
    "additionalProperties": false
  }
}
