{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/contractors.schema.json",
  "title": "Contractors",
  "type": "object",
  "required": ["id", "name", "die", "results"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "die": { "const": "1d100" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "range", "occupation", "salary", "combat",
                     "instinct", "maxWounds", "motivation", "source"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "range": { "$ref": "common.schema.json#/$defs/rollRange" },
          "occupation": { "type": "string", "minLength": 1 },
          "salary": { "$ref": "common.schema.json#/$defs/cost" },
          "combat": { "type": "integer", "minimum": 0, "maximum": 100 },
          "instinct": { "type": "integer", "minimum": 0, "maximum": 100 },
          "maxWounds": { "type": "integer", "minimum": 1 },
          "motivation": { "type": "string", "minLength": 1 },
          "source": { "$ref": "common.schema.json#/$defs/source" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
