{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/rules-index.schema.json",
  "title": "Rules index",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "page", "source"],
    "properties": {
      "id": { "type": "string", "pattern": "^\\d{1,2}\\.\\d{1,2}$" },
      "title": { "type": "string", "minLength": 1 },
      "page": { "type": "integer", "minimum": 1 },
      "source": { "$ref": "common.schema.json#/$defs/source" }
    },
    "additionalProperties": false
  }
}
