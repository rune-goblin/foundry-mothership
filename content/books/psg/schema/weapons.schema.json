{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/weapons.schema.json",
  "title": "Weapons",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "cost", "range", "damage", "wounds", "source"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "name": { "type": "string", "minLength": 1 },
      "cost": { "$ref": "common.schema.json#/$defs/cost" },
      "range": { "$ref": "common.schema.json#/$defs/rangeBand" },
      "damage": { "$ref": "common.schema.json#/$defs/damage" },
      "shots": { "type": ["integer", "null"], "minimum": 0 },
      "wounds": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "modifiers"],
          "properties": {
            "type": { "$ref": "common.schema.json#/$defs/woundType" },
            "modifiers": { "$ref": "common.schema.json#/$defs/modifiers" }
          },
          "additionalProperties": false
        }
      },
      "special": { "type": ["string", "null"] },
      "modifiers": { "$ref": "common.schema.json#/$defs/modifiers" },
      "source": { "$ref": "common.schema.json#/$defs/source" }
    },
    "additionalProperties": false
  }
}
