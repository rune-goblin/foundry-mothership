{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/trinkets.schema.json",
  "title": "Trinkets",
  "allOf": [{ "$ref": "common.schema.json#/$defs/rollTable" }],
  "type": "object",
  "required": ["source"],
  "properties": {
    "die": { "const": "1d100" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "results": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": ["range", "text"],
        "properties": {
          "range": { "$ref": "common.schema.json#/$defs/rollRange" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
