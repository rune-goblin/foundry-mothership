{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/classes.schema.json",
  "title": "Classes",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "adjustments", "maxWounds",
                 "traumaResponse", "skills", "source"],
    "additionalProperties": false,
    "properties": {
      "id": { "enum": ["marine", "android", "scientist", "teamster"] },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "maxWounds": { "type": "integer", "minimum": 1 },
      "traumaResponse": { "type": "string", "minLength": 1 },
      "source": { "$ref": "common.schema.json#/$defs/source" },
      "adjustments": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["raw", "value", "kind", "target"],
          "additionalProperties": false,
          "properties": {
            "raw": { "type": "string", "minLength": 1 },
            "value": { "type": "integer" },
            "kind": { "enum": ["stat", "save", "max-wounds"] },
            "target": {
              "enum": ["strength", "speed", "intellect", "combat",
                       "sanity", "fear", "body", "all", null]
            },
            "choose": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "skills": {
        "type": "object",
        "required": ["granted", "choices", "bonus"],
        "additionalProperties": false,
        "properties": {
          "granted": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/id" }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["raw", "tier", "count", "withPrerequisites"],
              "additionalProperties": false,
              "properties": {
                "raw": { "type": "string", "minLength": 1 },
                "tier": { "$ref": "#/$defs/tier" },
                "count": { "type": "integer", "minimum": 1 },
                "withPrerequisites": { "type": "boolean" }
              }
            }
          },
          "bonus": {
            "type": "object",
            "required": ["raw", "options"],
            "additionalProperties": false,
            "properties": {
              "raw": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["tier", "count"],
                    "additionalProperties": false,
                    "properties": {
                      "tier": { "$ref": "#/$defs/tier" },
                      "count": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "tier": { "enum": ["trained", "expert", "master"] }
  }
}
