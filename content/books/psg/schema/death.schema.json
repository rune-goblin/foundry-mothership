{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mothership/death.schema.json",
  "title": "Death",
  "allOf": [{ "$ref": "common.schema.json#/$defs/rollTable" }],
  "type": "object",
  "required": ["source"],
  "properties": {
    "die": { "const": "1d10" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["range", "effect"],
        "properties": {
          "range": { "$ref": "common.schema.json#/$defs/rollRange" },
          "effect": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
