{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mosh/fixture/gadgets.schema.json",
  "title": "Fixture gadgets",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "img", "description", "severity"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/contentId" },
      "name": { "type": "string", "minLength": 1 },
      "img": { "$ref": "common.schema.json#/$defs/img" },
      "description": { "$ref": "common.schema.json#/$defs/html" },
      "severity": { "type": "integer", "minimum": 0 },
      "modifiers": { "$ref": "common.schema.json#/$defs/modifiers" },
      "treatment": {
        "type": "object",
        "required": ["value", "html"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": "integer", "minimum": 0 },
          "html": { "$ref": "common.schema.json#/$defs/html" }
        }
      }
    }
  }
}
