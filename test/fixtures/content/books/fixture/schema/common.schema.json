{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runegoblin.dev/mosh/fixture/common.schema.json",
  "title": "Fixture value types — a book's schema idiom, in miniature",
  "$defs": {
    "contentId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "html": { "type": "string" },
    "img": { "type": "string", "pattern": "^systems/mothershiprpg/" },
    "rollRange": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "modifiers": {
      "type": "array",
      "items": { "enum": ["advantage", "disadvantage"] },
      "uniqueItems": true
    }
  }
}
