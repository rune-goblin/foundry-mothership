{
  "name": "mothershiprpg",
  "version": "0.0.0",
  "description": "MoSh - the unofficial Mothership system for Foundry VTT",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "clean": "rm -rf dist",
    "setup": "node scripts/setup.ts",
    "deploy": "node scripts/deploy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json",
    "test:e2e": "npm run build && ./scripts/packs.sh pack && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:setup": "node scripts/setup-test-env.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:foundry": "bash scripts/start-test-env.sh",
    "check:e2e": "tsc --noEmit -p test/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.12.0",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
