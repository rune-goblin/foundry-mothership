{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // "svelte" supplies the ambient `declare module '*.svelte'`, without which the component
    // contract test cannot import the primitives it mounts.
    "types": ["node", "svelte"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The system's 9,274 lines of legacy JS are importable but not yet type-checked.
    // Flip checkJs on per-file with // @ts-check, or globally once the conversion starts.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  // test/e2e has its own tsconfig: Playwright globals, and it must not be type-checked
  // with the vitest surface.
  "exclude": ["node_modules", "dist", "test/e2e", "test/foundry-data"]
}
